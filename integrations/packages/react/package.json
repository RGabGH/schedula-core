{
  "name": "schedula-core-react",
  "version": "1.4.0",
  "description": "Official React wrapper for SchedulaCore — fast, lightweight Gantt chart & resource scheduler component.",
  "keywords": [
    "gantt",
    "gantt-chart",
    "scheduler",
    "resource-scheduler",
    "timeline",
    "react",
    "react-component",
    "schedula-core"
  ],
  "homepage": "https://rgabgh.github.io/schedula-core/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RGabGH/schedula-core.git",
    "directory": "public/integrations/packages/react"
  },
  "license": "MIT",
  "author": "Raffaele Gabrielli <gabriraf@gmail.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "schedula-core": ">=1.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "schedula-core": "file:../../..",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  }
}
